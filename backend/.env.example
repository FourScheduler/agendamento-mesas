# Copie este arquivo para .env (na pasta backend/) e ajuste os valores.
# Opcional: a aplicação inicia com os padrões abaixo mesmo sem um arquivo .env.
SERVER_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:4201

# Banco de dados MySQL próprio do projeto (banco: agendamento_mesas).
# Crie o schema antes (ou deixe o createDatabaseIfNotExist criar):
#   CREATE DATABASE agendamento_mesas CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# Preencha usuário/senha locais; não versione .env nem credenciais.
#
# Importante: o .env é lido pelo Spring a partir do diretório de trabalho.
# Rode a aplicação a partir de backend/ (ex.: .\mvnw.cmd spring-boot:run)
# ou configure o IntelliJ com working directory = backend.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=agendamento_mesas
DB_USERNAME=root
DB_PASSWORD=
