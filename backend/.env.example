# Opcional: a aplicação inicia com os padrões abaixo mesmo sem um arquivo .env.
SERVER_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:4201

# Banco de dados MySQL próprio do projeto (banco: agendamento_mesas).
# Crie o schema antes de subir a aplicação:
#   CREATE DATABASE agendamento_mesas CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# Preencha usuário/senha localmente; não versione .env nem credenciais.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/agendamento_mesas
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=
